generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Snippet {
  id          Int      @id @default(autoincrement())
  title       String
  code        String
  language    String
  description String?
  tags        Tag[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  snippets Snippet[]
}